{{ if eq .chezmoi.hostname "macmini" -}}
Include /Users/kef/.colima/ssh_config

# Synology NAS. The mini has its own scoped key (macmini-nas-health) and
# passwordless sudo there, so scripts/synology/deploy.sh works unattended.
Host nas 192.168.7.4
  HostName 192.168.7.4
  User kef
  IdentityFile ~/.ssh/id_ed25519_nas
  IdentitiesOnly yes

# MacBook, while it is on the home LAN. Away from home it needs its WireGuard
# address instead; Bonjour does not cross the tunnel.
Host mbp kef-mbp.local
  HostName kef-mbp.local
  User kef
  IdentityFile ~/.ssh/id_ed25519_mbp
  IdentitiesOnly yes

# The mini has no ~/.ssh/id_ed25519, so it uses its own key for the Pi5 and
# the UDM. These come before the shared entries, so their settings win; the
# shared id_ed25519 line still applies but is skipped because the file is absent.
Host ha
  HostName 192.168.7.5
  User kef
  IdentityFile ~/.ssh/id_ed25519_mbp
  IdentitiesOnly yes

Host udm
  HostName 192.168.7.1
  User root
  IdentityFile ~/.ssh/id_ed25519_mbp
  IdentitiesOnly yes

{{ else -}}
# UniFi Dream Machine SE. A firmware update can wipe root's authorized_keys;
# re-run ssh-copy-id if the key stops working.
Host udm
  HostName 192.168.7.1
  User root
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

{{ end -}}
Host github.com
  Hostname ssh.github.com
  Port 443
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

Host ha
  HostName 192.168.7.5
  User kef
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

Host macmini
  HostName 192.168.7.20
  User kef
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
  ForwardAgent yes

Match exec "test -S \"$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock\" && test -z \"$SSH_TTY\""
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
