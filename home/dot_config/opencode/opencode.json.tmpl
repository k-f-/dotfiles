{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": false
    },
    "splitrail": {
      "type": "local",
      "command": [
        "splitrail",
        "mcp"
      ],
      "enabled": false
    },
    "agr": {
      "type": "local",
      "command": [
        "{{ .chezmoi.homeDir }}/Documents/Code/agr-mcp/start.sh"
      ],
      "environment": {
        "AGENTREPO_PATH": "{{ .chezmoi.homeDir }}/Documents/Code/agr"
      },
      "enabled": true
    }
  },
  "plugin": [
    "oh-my-openagent@latest",
    "file://{{ .chezmoi.homeDir }}/Documents/Code/agr-plugin",
    "file://{{ .chezmoi.homeDir }}/Documents/Code/kitty-tab-notify-plugin"
  ]
}
