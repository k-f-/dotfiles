#!/usr/bin/env bash
# =============================================================================
# herd — one command to reach every Claude Code session on the mini
# =============================================================================
# The mini runs a herdr server as a LaunchAgent in the GUI login session. That
# placement is load-bearing: Claude Code keeps its OAuth credential in the login
# keychain, and a keychain read from an SSH session fails with
# errSecInteractionNotAllowed. Panes spawned by the GUI-session server inherit
# the working login; panes spawned from SSH do not.
#
# So this script ATTACHES to a server that is already running. It never starts
# one over SSH. If the server is down, it asks launchd to bring it back.
#
#   herd            attach to the mini's herdr session
#   herd --list     what is running, without attaching (no TTY needed)
#   herd --local    run herdr here instead (mini unreachable)
#   herd --ssh      force ssh transport instead of Eternal Terminal
#   herd --status   health check: server, versions, config drift
#   herd --reap     kill stale herdr clients left by closed terminals
#   herd thread <agr-folder> [--cwd <dir>] [--label <text>] [--prompt <text>]
#                            [-- agent-flags...]
#                   open one Thread on the mini with AGR_FOLDER set, so the
#                   archiver files the transcript there instead of guessing.
#                   --cwd sets the pane's directory, which is what decides
#                   whether a repo's AGENTS.md loads. --prompt is sent after
#                   the agent is up, because herdr refuses an argv element
#                   that holds a newline and agr prompts are multi-line.
#
# Detach with ctrl+b q. Closing the terminal instead leaves ET waiting for a
# peer that never returns, because surviving a dropped connection is the whole
# point of ET -- so the window will not close and the client leaks.
# =============================================================================

set -uo pipefail

HOST="${HERD_HOST:-macmini}"
AGENT="com.macmini.herdr"
CONNECT_TIMEOUT=5

say()  { printf '%s\n' "$*" >&2; }
warn() { printf '\033[0;33m ⚠\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[0;31m ✗\033[0m %s\n' "$*" >&2; }

# Print the header block as help. Derived from the banner lines rather than a
# hardcoded range, which silently truncated twice when the header grew.
usage() {
    awk '/^# ={10,}/ {n++; next} n==3 {exit} n>=1 {print}' "$0" | sed 's/^# \{0,1\}//'
}

remote() { ssh -o BatchMode=yes -o ConnectTimeout="$CONNECT_TIMEOUT" "$HOST" "$@"; }

reachable() { remote true >/dev/null 2>&1; }

# --- drift check -------------------------------------------------------------
# The mini has silently fallen behind before (Claude pinned at 2.1.42 for six
# months, a stale hook, a chezmoi source path pointing at a directory that did
# not exist). Surfacing it on every connect is cheap; noticing it by accident
# months later is not.
fingerprint_local() {
    printf '%s|%s|%s\n' \
        "$(claude --version 2>/dev/null | awk '{print $1}')" \
        "$(shasum -a 256 "$HOME/.claude/settings.json" 2>/dev/null | awk '{print $1}')" \
        "$(shasum -a 256 "$HOME/.claude/hooks/agr-archive.sh" 2>/dev/null | awk '{print $1}')"
}

fingerprint_remote() {
    remote 'printf "%s|%s|%s\n" \
        "$($HOME/.local/bin/claude --version 2>/dev/null | awk "{print \$1}")" \
        "$(shasum -a 256 $HOME/.claude/settings.json 2>/dev/null | awk "{print \$1}")" \
        "$(shasum -a 256 $HOME/.claude/hooks/agr-archive.sh 2>/dev/null | awk "{print \$1}")"'
}

check_drift() {
    local l r
    l="$(fingerprint_local)"; r="$(fingerprint_remote)"
    [ -z "$r" ] && return 0
    [ "$l" = "$r" ] && return 0
    local lv rv; lv="${l%%|*}"; rv="${r%%|*}"
    if [ "$lv" != "$rv" ]; then
        warn "Claude version differs — here $lv, $HOST $rv. Run: ssh $HOST 'claude update'"
    else
        warn "Claude config differs from $HOST. Run: ssh $HOST 'chezmoi diff'"
    fi
}

# --- server ------------------------------------------------------------------
server_running() {
    remote 'PATH=/opt/homebrew/bin:$PATH herdr status server 2>/dev/null | grep -q "status: running"'
}

ensure_server() {
    server_running && return 0
    warn "herdr server is not running on $HOST — asking launchd to start it"
    # kickstart, not a bare `herdr server`: launchd owns it so it lands in the
    # GUI session where the keychain is readable.
    remote "launchctl kickstart -k gui/\$(id -u)/$AGENT" >/dev/null 2>&1
    for _ in 1 2 3 4 5 6 7 8; do
        sleep 1
        server_running && { say "server is up"; return 0; }
    done
    err "herdr server did not come up. Check: ssh $HOST 'tail -30 /tmp/macmini-herdr.log'"
    return 1
}

# --- filesystem access -------------------------------------------------------
# herdr needs macOS permission to read protected folders. TCC attributes a pane
# to the binary that spawned it, so without a grant every pane inherits the
# denial and any read under ~/Documents blocks forever waiting on a consent
# prompt that can never be shown. The symptom is a pane with no shell prompt
# that swallows what you type -- it looks like herdr is broken rather than
# unpermitted.
#
# A symlink does not help (TCC resolves to the real binary) and neither does
# wrapping herdr in an already-granted interpreter; both were tested. The grant
# records the resolved Cellar path, so `brew upgrade herdr` moves the binary
# and silently invalidates it -- the same way this machine ended up with two
# separate grants for python@3.14.
#
# Accept any granted service, in either database. Approving the prompt macOS
# raises writes kTCCServiceFileProviderDomain to the user db, which is enough;
# insisting on Full Disk Access here produced a false alarm on a working setup.
check_fs_access() {
    local real granted
    real="$(remote 'python3 -c "import os;print(os.path.realpath(\"/opt/homebrew/bin/herdr\"))"' 2>/dev/null)"
    [ -n "$real" ] || return 0
    granted="$(remote "for db in \"\$HOME/Library/Application Support/com.apple.TCC/TCC.db\" \
                              '/Library/Application Support/com.apple.TCC/TCC.db'; do \
        sqlite3 \"\$db\" \"select 1 from access where client='$real' and auth_value=2\" 2>/dev/null; \
      done | head -1" 2>/dev/null)"
    [ -n "$granted" ] && return 0
    warn "herdr has no filesystem grant recorded on $HOST."
    say  "If panes open with no shell prompt and swallow what you type, that is why."
    say  "Fix: System Settings > Privacy & Security > Full Disk Access > +"
    say  "     add  $real     (or re-approve the prompt macOS raises)"
    say  "then: ssh $HOST 'launchctl kickstart -k gui/\$(id -u)/$AGENT'"
    return 0   # warn, never block -- a wrong read here must not strand you
}

# --- transport ---------------------------------------------------------------
# Eternal Terminal survives IP changes and VPN flips, and keeps OSC52 clipboard
# working. mosh roams too but breaks OSC52, so it is deliberately not used here.
attach() {
    local force_ssh="$1"
    # Check that etserver is LISTENING, not merely installed. Testing for the
    # binary is what let this try ET against a dead server: Homebrew's et had
    # been broken since a protobuf upgrade, so etserver aborted on launch while
    # the binary sat there looking healthy.
    if [ "$force_ssh" = "no" ] && command -v et >/dev/null 2>&1 \
       && remote 'nc -z -G 3 127.0.0.1 2022 >/dev/null 2>&1'; then
        et "$HOST" -c 'PATH=/opt/homebrew/bin:$PATH herdr' && return 0
        warn "Eternal Terminal failed — falling back to ssh"
    fi
    ssh -t "$HOST" 'PATH=/opt/homebrew/bin:$PATH herdr'
}

# --- main --------------------------------------------------------------------
force_ssh=no
case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --local)
        command -v herdr >/dev/null 2>&1 || { err "herdr is not installed here"; exit 1; }
        exec herdr
        ;;
    --list)
        reachable || { err "$HOST is unreachable. On the road? Bring up WireGuard first."; exit 1; }
        remote 'PATH=/opt/homebrew/bin:$PATH herdr agent list 2>/dev/null' \
            | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("no agents running"); sys.exit(0)
rows = d.get("result", {}).get("agents", [])
if not rows:
    print("no agents running"); sys.exit(0)
for a in rows:
    print(f'"'"'{a.get("agent_status","?"):<10} {a.get("label") or a.get("pane_id","?"):<28} {a.get("cwd","")}'"'"')
'
        exit 0
        ;;
    --status)
        reachable || { err "$HOST is unreachable."; exit 1; }
        remote 'PATH=/opt/homebrew/bin:$PATH; echo "herdr:"; herdr status server 2>&1 | sed "s/^/  /" | head -5; echo "claude: $($HOME/.local/bin/claude --version 2>/dev/null)"; echo "agr:    $($HOME/go/bin/agr version 2>/dev/null)"'
        check_drift
        exit 0
        ;;
    --reap)
        # ET is built to survive a dropped connection, so closing the terminal
        # without detaching (ctrl+b q) leaves the herdr client on the mini
        # waiting for a peer that will never return. They accumulate. Killing a
        # client is safe: panes live in the server, not the client.
        reachable || { err "$HOST is unreachable."; exit 1; }
        remote 'n=0; for p in $(pgrep -x herdr); do
              case "$(ps -o command= -p $p)" in *"herdr server"*) continue ;; esac
              kill $p 2>/dev/null && n=$((n+1))
            done; echo "reaped $n stale client(s)"'
        remote 'PATH=/opt/homebrew/bin:$PATH herdr status server 2>/dev/null | head -2'
        exit 0
        ;;
    thread)
        shift
        folder="${1:-}"
        [ -n "$folder" ] || { err "usage: herd thread <agr-folder> [--cwd <dir>] [--label <text>] [--prompt <text>] [-- agent-flags...]"; exit 1; }
        shift
        thread_cwd=""
        thread_label=""
        thread_prompt=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --cwd)    thread_cwd="${2:-}"; shift 2 ;;
                --label)  thread_label="${2:-}"; shift 2 ;;
                --prompt) thread_prompt="${2:-}"; shift 2 ;;
                --)       shift; break ;;
                *)        break ;;
            esac
        done
        reachable || { err "$HOST is unreachable."; exit 1; }
        ensure_server || exit 1

        # herdr agent names must match [a-z][a-z0-9_-]{0,31} and be unique
        # among live agents. Derive one from the folder's last segment.
        agent_name="$(printf '%s' "${folder##*/}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | cut -c1-32)"
        case "$agent_name" in [a-z]*) ;; *) agent_name="t$agent_name" ;; esac

        rq() { printf '%q' "$1"; }

        # tab create returns the new pane id; agent start needs it.
        cwd_arg=""
        [ -n "$thread_cwd" ] && cwd_arg=" --cwd $(rq "$thread_cwd")"
        env_arg=" --env AGR_FOLDER=$(rq "$folder")"

        # agr passes the conversation title. Fall back to the folder so a
        # hand-typed `herd thread <folder>` still labels its tab.
        tab_label="${thread_label:-agr: $folder}"

        # A Project is a workspace; a Thread is a tab inside it. `tab create`
        # targets whichever workspace is focused, so without this every Thread
        # piles into whatever the user happened to be looking at.
        ws_label="${folder##*/}"
        ws="$(remote "PATH=/opt/homebrew/bin:\$PATH herdr workspace list" 2>/dev/null \
            | python3 -c "import json,sys
try:
    ws = json.load(sys.stdin)['result']['workspaces']
except Exception:
    ws = []
print(next((w['workspace_id'] for w in ws if w.get('label') == '$ws_label'), ''))" 2>/dev/null)"

        if [ -z "$ws" ]; then
            # A new workspace comes with a root pane. Use it rather than
            # creating a tab beside it, which would leave an empty one.
            read -r pane tab <<<"$(remote "PATH=/opt/homebrew/bin:\$PATH herdr workspace create --label $(rq "$ws_label")$cwd_arg$env_arg --focus" 2>/dev/null \
                | python3 -c "import json,sys
try:
    p = json.load(sys.stdin)['result']['root_pane']
    print(p['pane_id'], p['tab_id'])
except Exception:
    print('')" 2>/dev/null)"
            if [ -n "$pane" ]; then
                say "Created Project workspace: $ws_label"
                # workspace create labels the workspace, not its root tab, so
                # without this the Thread tab keeps its bare number.
                remote "PATH=/opt/homebrew/bin:\$PATH herdr tab rename $(rq "$tab") $(rq "$tab_label")" >/dev/null 2>&1
            fi
        else
            remote "PATH=/opt/homebrew/bin:\$PATH herdr workspace focus $(rq "$ws")" >/dev/null 2>&1
            pane="$(remote "PATH=/opt/homebrew/bin:\$PATH herdr tab create --label $(rq "$tab_label")$cwd_arg$env_arg" 2>/dev/null \
                | python3 -c "import json,sys
try:
    d = json.load(sys.stdin)['result']
    print(d.get('pane', {}).get('pane_id') or d.get('root_pane', {}).get('pane_id') or '')
except Exception:
    print('')" 2>/dev/null)"
        fi
        [ -n "$pane" ] || { err "could not create a Thread on $HOST"; exit 1; }

        agent_args=""
        for arg in "$@"; do agent_args="$agent_args $(rq "$arg")"; done

        # The new pane's shell needs a moment to reach its prompt, and agent
        # start refuses a pane that has not got there yet. Measured on the
        # mini: the call straight after workspace create returns
        # agent_pane_busy, the next one succeeds. Only that error is worth
        # retrying; anything else is real, so report what herdr actually said.
        start_cmd="PATH=/opt/homebrew/bin:\$PATH herdr agent start $(rq "$agent_name") --kind claude --pane $(rq "$pane")${agent_args:+ --$agent_args}"
        started=no
        start_out=""
        for _ in $(seq 20); do
            start_out="$(remote "$start_cmd" 2>&1)" && { started=yes; break; }
            case "$start_out" in *agent_pane_busy*) sleep 0.25 ;; *) break ;; esac
        done
        if [ "$started" != yes ]; then
            warn "Thread $pane created, but the agent did not start. Attach and run claude yourself."
            err "herdr agent start: $start_out"
            exit 1
        fi
        # The prompt goes in its own call. herdr rejects an argv element that
        # holds a newline (invalid_agent_argument), and every folder prompt is
        # multi-line. `agent prompt` takes multi-line text and delivers it as
        # one message.
        if [ -n "$thread_prompt" ]; then
            if ! prompt_out="$(remote "PATH=/opt/homebrew/bin:\$PATH herdr agent prompt $(rq "$agent_name") $(rq "$thread_prompt")" 2>&1)"; then
                warn "Thread $pane is up, but the prompt did not go through. Type it in the pane."
                err "herdr agent prompt: $prompt_out"
                exit 1
            fi
        fi
        say "Opened Thread $pane on $HOST for $folder (agent: $agent_name)"
        exit 0
        ;;
    --ssh) force_ssh=yes ;;
    "") ;;
    *) err "unknown option: $1"; usage; exit 1 ;;
esac

if ! reachable; then
    warn "$HOST did not answer on the LAN."
    say  "If you are away from home, bring up WireGuard, then run this again."
    sleep 2
    reachable || { err "still unreachable — giving up"; exit 1; }
fi

ensure_server || exit 1
check_fs_access
check_drift
attach "$force_ssh"
