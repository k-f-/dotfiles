#!/usr/bin/env bash
#
# aerospace-organize - Apply all workspace layouts
#
# Reads ~/.config/universal-wm/layouts.json and runs each layout through the
# aerospace adapter at universal-layout-manager/adapters/aerospace.ts via bun.
#
# Usage:
#   aerospace-organize           # Launch apps and organize
#   aerospace-organize --no-launch   # Only organize existing windows

set -euo pipefail

# Parse arguments
NO_LAUNCH_FLAG=""
if [[ "${1:-}" == "--no-launch" ]]; then
    NO_LAUNCH_FLAG="--noLaunch"
fi

# Find dotfiles directory: prefer ~/.config/dotfiles/env (works whether this
# script is a symlink or a chezmoi-managed copy); fall back to walking our own
# symlink for checkouts where ./install hasn't written the env file yet.
[[ -f "${HOME}/.config/dotfiles/env" ]] && source "${HOME}/.config/dotfiles/env"
if [[ -z "${DOTFILES_DIR:-}" || ! -d "${DOTFILES_DIR}" ]]; then
    SCRIPT_PATH="${BASH_SOURCE[0]}"
    # macOS readlink has no -f, so walk symlinks manually
    while [ -L "$SCRIPT_PATH" ]; do
        SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
        SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
        [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
    done
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    DOTFILES_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
fi
LAYOUT_MANAGER="$DOTFILES_DIR/universal-layout-manager/adapters/aerospace.ts"

# Use full path to bun
BUN="$HOME/.bun/bin/bun"

# Log file for debugging
LOG_FILE="/tmp/aerospace-organize.log"

# Log start time
echo "=== $(date) ===" >> "$LOG_FILE"
echo "Using layout manager: $LAYOUT_MANAGER" >> "$LOG_FILE"
echo "Using bun: $BUN" >> "$LOG_FILE"
echo "No-launch flag: $NO_LAUNCH_FLAG" >> "$LOG_FILE"

# Get all available layouts
# stderr goes to the log, NOT into $layouts. It used to be folded in with 2>&1,
# so any warning line would word-split into bogus "layout names" that then fail —
# which the new fail_count would report as a red notification. The `if !` still
# catches a genuine failure via the exit status.
if ! layouts=$("$BUN" "$LAYOUT_MANAGER" --listLayouts 2>>"$LOG_FILE"); then
    echo "ERROR: Failed to list layouts (see stderr above)" >> "$LOG_FILE"
    osascript -e 'display notification "Failed to list layouts" with title "Aerospace Organize"'
    exit 1
fi

echo "Found layouts: $layouts" >> "$LOG_FILE"

# Apply each layout.
# IFS=$'\n': --listLayouts emits one name per line, and a layout key containing a
# space would otherwise split into two bogus names that fail and red-notify.
total_count=0
fail_count=0
IFS=$'\n'
for layout in $layouts; do
    total_count=$((total_count + 1))
    echo "Applying layout: $layout" >> "$LOG_FILE"
    if "$BUN" "$LAYOUT_MANAGER" $NO_LAUNCH_FLAG "$layout" 2>>"$LOG_FILE"; then
        echo "  ✓ Applied: $layout" >> "$LOG_FILE"
    else
        echo "  ✗ Failed: $layout" >> "$LOG_FILE"
        fail_count=$((fail_count + 1))
    fi
done

if [[ "$total_count" -eq 0 ]]; then
    echo "✗ No layouts found" >> "$LOG_FILE"
    osascript -e "display notification \"No layouts found to apply — see $LOG_FILE\" with title \"Aerospace Organize\""
    exit 1
fi

if [[ "$fail_count" -gt 0 ]]; then
    echo "✗ $fail_count of $total_count layouts failed" >> "$LOG_FILE"
    osascript -e "display notification \"$fail_count of $total_count layouts failed — see $LOG_FILE\" with title \"Aerospace Organize\""
    exit 1
fi

if [[ -n "$NO_LAUNCH_FLAG" ]]; then
    echo "✓ All layouts organized" >> "$LOG_FILE"
    osascript -e 'display notification "All layouts organized" with title "Aerospace Organize"'
else
    echo "✓ All layouts applied" >> "$LOG_FILE"
    osascript -e 'display notification "All layouts applied" with title "Aerospace Organize"'
fi
