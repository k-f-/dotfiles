#!/usr/bin/env bash
# =============================================================================
# agr-sweep — archive Claude Code sessions that were abandoned, not ended
# =============================================================================
# The agr archiver only ever runs from the SessionEnd hook. A session you walk
# away from and never close is never archived, and `agr archive` has no mode for
# rescuing a stale transcript after the fact -- it takes `claude-hook` (reading
# the hook payload on stdin) or `doc`, nothing else.
#
# Persistent sessions on the mini make that failure mode much easier to hit, so
# this reconstructs the hook payload for transcripts that have gone quiet and
# feeds them to the same archiver the hook uses.
#
#   agr-sweep              archive transcripts idle longer than IDLE_HOURS
#   agr-sweep --dry-run    list what it would archive, change nothing
#   agr-sweep --hours N    override the idle threshold
# =============================================================================

set -uo pipefail

IDLE_HOURS="${AGR_SWEEP_IDLE_HOURS:-12}"
DRY_RUN=no
PROJECTS_DIR="$HOME/.claude/projects"
AGR_BIN="$HOME/go/bin/agr"
STATE_DIR="$HOME/.local/state/agr-sweep"
SWEPT="$STATE_DIR/swept.txt"
LOG="${TMPDIR:-/tmp}/agr-sweep.log"
# Space-separated cwd prefixes to ignore. Override with AGR_SWEEP_EXCLUDE.
EXCLUDE_CWD_PREFIXES="${AGR_SWEEP_EXCLUDE:-$HOME/.local/state}"

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=yes; shift ;;
        --hours)   IDLE_HOURS="$2"; shift 2 ;;
        -h|--help) sed -n '4,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
done

[ -x "$AGR_BIN" ] || { echo "agr binary not found at $AGR_BIN" >&2; exit 1; }
[ -d "$PROJECTS_DIR" ] || exit 0
mkdir -p "$STATE_DIR"; touch "$SWEPT"

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

# A session Claude Code still has open must not be swept -- archiving a live
# transcript would race the real SessionEnd hook. `claude agents --json` is
# documented as not requiring a TTY, which is what makes this safe from cron.
live_ids="$(claude agents --json 2>/dev/null \
    | python3 -c 'import json,sys
try: rows = json.load(sys.stdin)
except Exception: rows = []
print("\n".join(str(r.get("sessionId") or r.get("session_id") or "") for r in rows))' 2>/dev/null)"

# Everything the archive already holds. Archived conversations carry their
# session_id in frontmatter, so this is authoritative -- far better than
# trusting a local state file that a reinstall or a second machine would miss.
AGR_REPO="${AGR_REPO:-$HOME/Documents/Code/agr}"
archived_ids="$(grep -rhoE '^session_id: .+' "$AGR_REPO" 2>/dev/null | sed 's/^session_id: //' | tr -d "'\"")"

swept_count=0
while IFS= read -r transcript; do
    [ -n "$transcript" ] || continue

    session_id="$(basename "$transcript" .jsonl)"

    # agent-* transcripts are subagent side-conversations, not sessions Kyle
    # had. The SessionEnd hook never archives them and neither should this.
    case "$session_id" in agent-*) continue ;; esac

    grep -qxF "$session_id" "$SWEPT" && continue
    printf '%s\n' "$archived_ids" | grep -qxF "$session_id" && continue
    printf '%s\n' "$live_ids" | grep -qxF "$session_id" && continue

    # Claude Code encodes the project path into the directory name by replacing
    # separators with dashes, which is lossy. Read the real cwd out of the
    # transcript instead of trying to decode it.
    cwd="$(python3 - "$transcript" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path) as fh:
        for line in fh:
            try:
                rec = json.loads(line)
            except Exception:
                continue
            if isinstance(rec, dict) and rec.get("cwd"):
                print(rec["cwd"]); break
except OSError:
    pass
PY
)"
    [ -n "$cwd" ] && [ -d "$cwd" ] || { log "skip $session_id: no usable cwd"; continue; }

    # Headless automation (brief-compiler's `claude -p` runs, and anything else
    # driven from a state directory) is not a conversation Kyle had. The normal
    # SessionEnd path does not archive these, so neither does the sweep.
    skip=no
    for prefix in $EXCLUDE_CWD_PREFIXES; do
        case "$cwd" in "$prefix"*) skip=yes; break ;; esac
    done
    [ "$skip" = yes ] && continue

    if [ "$DRY_RUN" = yes ]; then
        printf 'would archive  %s  (%s)\n' "$session_id" "$cwd"
        continue
    fi

    payload="$(python3 -c 'import json,sys; print(json.dumps({"session_id":sys.argv[1],"transcript_path":sys.argv[2],"cwd":sys.argv[3]}))' \
        "$session_id" "$transcript" "$cwd")"

    if printf '%s' "$payload" | (cd "$cwd" && "$AGR_BIN" archive claude-hook) >/dev/null 2>&1; then
        printf '%s\n' "$session_id" >> "$SWEPT"
        swept_count=$((swept_count + 1))
        log "archived $session_id ($cwd)"
    else
        log "FAILED $session_id ($cwd)"
    fi
done < <(find "$PROJECTS_DIR" -name '*.jsonl' -type f -mmin "+$((IDLE_HOURS * 60))" 2>/dev/null)

[ "$DRY_RUN" = yes ] || log "sweep done, archived $swept_count"
[ "$DRY_RUN" = yes ] || [ "$swept_count" -eq 0 ] || echo "agr-sweep archived $swept_count session(s)"
