#!/usr/bin/env bash
# =============================================================================
# sysup — bring this Mac up to date, then surface anything that needs a click
# =============================================================================
# Order matters. Dotfiles go first, so a Brewfile change installs before the
# upgrades run. Then topgrade (brew formulae and casks, App Store, oh-my-zsh),
# then mackup.
#
# The last pass is the point of running this by hand. An upgrade changes an
# app's code signature, and macOS can drop its privacy grant (TCC) with it. The
# next headless run then fails with nobody there to see the prompt. So every
# upgraded app opens once now, and every launchd job whose last run failed is
# listed, while someone is watching.
# =============================================================================

set -uo pipefail

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }

# iCloud syncs the working tree, and a conflict leaves "name 2" copies. chezmoi
# would install a copy from home/ into ~, so stop before it runs.
step "iCloud duplicates"
repo=$(chezmoi execute-template '{{ .chezmoi.workingTree }}')
dupes=$(find "$repo/home" "$repo/.git" \( -name '* [0-9]' -o -name '* [0-9].*' \) -prune -print)
if [[ -n $dupes ]]; then
    echo "$dupes"
    echo "stopped: check each copy for edits the original lacks, then remove them and re-run:"
    printf 'rm -rf'
    while IFS= read -r f; do printf ' %q' "$f"; done <<< "$dupes"
    echo
    exit 1
fi
echo "none"

step "dotfiles (chezmoi)"
chezmoi status
chezmoi update   # pull, then apply; asks about files changed on both sides

step "upgrades (topgrade)"
brew update --quiet
upgraded_casks=$(brew outdated --cask --quiet)
upgraded_formulae=$(brew outdated --formula --quiet)
command topgrade --yes --no-retry --only brew_formula brew_cask mas shell

# et is built from source against the exact protobuf dylib, so a protobuf bump
# leaves etserver unable to load. The running daemon masks it until the next
# reboot, then every remote session fails (2026-10-23).
if grep -qx protobuf <<< "$upgraded_formulae"; then
    step "rebuild et (protobuf changed)"
    brew reinstall mistertea/et/et
fi

# A pipx venv links the brew python it was built on. When brew drops that
# python (upgrade, autoremove) every script in the venv dies with "bad
# interpreter"; osxphotos failed four nights that way (2026-10-21). Rebuild
# only the venvs whose python is gone.
step "pipx venvs"
rebuilt=no
for py in "$HOME"/.local/pipx/venvs/*/bin/python; do
    [[ -L $py && ! -e $py ]] || continue
    name=$(basename "${py%/bin/python}")
    echo "rebuilding $name: its python is gone"
    pipx reinstall "$name" && rebuilt=yes
done
[[ $rebuilt == no ]] && echo "all pipx venvs load"

# A running daemon keeps its old libraries mapped, so a binary an upgrade broke
# fails only at the next reboot. Check every KeepAlive agent that runs a brew
# binary now: each library it links must still exist. Restarting them instead
# would kill this session (etserver) or drop Remote Control (herdr).
step "daemon binaries"
broken=no
for plist in "$HOME"/Library/LaunchAgents/*.plist; do
    plutil -extract KeepAlive xml1 -o /dev/null "$plist" 2>/dev/null || continue
    prog=$(plutil -extract ProgramArguments.0 raw -o - "$plist" 2>/dev/null)
    [[ $prog == /opt/homebrew/* ]] || continue
    while IFS= read -r lib; do
        [[ $lib == /opt/homebrew/* && ! -e $lib ]] || continue
        broken=yes
        echo "BROKEN $(basename "$prog"): $lib is gone. Reinstall it, then:"
        echo "  launchctl kickstart -k gui/$UID/$(plutil -extract Label raw -o - "$plist")"
    done < <(otool -L "$prog" 2>/dev/null | awk 'NR>1 {print $1}')
done
[[ $broken == no ]] && echo "all daemon binaries load"

step "app settings (mackup)"
if [[ "$(chezmoi execute-template '{{ default false .desktop }}')" == true ]]; then
    mackup backup --force
else
    echo "skipped: only the desktop machine writes the shared mackup copy"
fi

step "permissions"
opened=no
for cask in $upgraded_casks; do
    while IFS= read -r app; do
        [[ -d "/Applications/$app" ]] || continue
        echo "opening $app"
        open -a "/Applications/$app" && opened=yes
    done < <(brew info --cask --json=v2 "$cask" |
        jq -r '.casks[].artifacts[] | select(type=="object" and has("app")) | .app[] | strings')
done
[[ $opened == no ]] && echo "no upgraded apps to open"

failed=no
for plist in "$HOME"/Library/LaunchAgents/*.plist; do
    label=$(plutil -extract Label raw -o - "$plist" 2>/dev/null) || continue
    code=$(launchctl print "gui/$UID/$label" 2>/dev/null |
        awk -F'= ' '/last exit code/ {print $2; exit}')
    [[ -z $code || $code == 0 || $code == "(never exited)" ]] && continue
    failed=yes
    log=$(plutil -extract StandardErrorPath raw -o - "$plist" 2>/dev/null)
    echo "FAILED last run (exit $code): $label${log:+  log: $log}"
done
if [[ $failed == yes ]]; then
    echo "re-run one while watching: launchctl kickstart -k gui/$UID/<label>"
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"
fi

if [[ $opened == yes || $failed == yes ]]; then
    echo
    echo "Any prompts are on this Mac's screen. Not in front of it? From the other Mac:"
    echo "  open vnc://$(scutil --get LocalHostName).local"
fi
