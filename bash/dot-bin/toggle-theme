#!/usr/bin/env bash
#
# toggle-theme - Toggle between themes using the aesthetics submodule
#
# This script wraps the aesthetics/scripts/toggle-theme.sh and resolves
# the correct path even when called from symlinks.
#
# Usage:
#   toggle-theme         # Toggle between primary and configured variant
#   toggle-theme --cycle # Cycle through all available variants

set -euo pipefail

# Find dotfiles directory: prefer ~/.config/dotfiles/env (works whether this
# script is a symlink or a chezmoi-managed copy); fall back to walking our own
# symlink for checkouts where ./install hasn't written the env file yet.
[[ -f "${HOME}/.config/dotfiles/env" ]] && source "${HOME}/.config/dotfiles/env"
if [[ -z "${DOTFILES_DIR:-}" || ! -d "${DOTFILES_DIR}" ]]; then
    SCRIPT_PATH="${BASH_SOURCE[0]}"
    # macOS readlink has no -f, so walk symlinks manually
    while [ -L "$SCRIPT_PATH" ]; do
        SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
        SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
        [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
    done
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    DOTFILES_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
fi
THEME_SCRIPT="$DOTFILES_DIR/aesthetics/scripts/toggle-theme.sh"

# Check if the theme script exists
if [[ ! -f "$THEME_SCRIPT" ]]; then
    echo "Error: aesthetics theme script not found at: $THEME_SCRIPT" >&2
    echo "Make sure the aesthetics submodule is initialized:" >&2
    echo "  cd $DOTFILES_DIR && git submodule update --init" >&2
    exit 1
fi

# Execute the theme toggle script with all arguments passed through
exec bash "$THEME_SCRIPT" "$@"
